# Copy to .env. WordCraft reads XAI_API_KEY from the environment first, then from
# this file in the current directory, from WORDCRAFT_DOTENV, or from
# $XDG_CONFIG_HOME/wordcraft/.env (usually ~/.config/wordcraft/.env).
#
# A Grok command sends only the selection (or a capped excerpt) to https://api.x.ai
# after you run it. The key is not written into the document or the log.
# Create the key in the xAI console. Do not commit .env.

XAI_API_KEY=

# Optional model id. The default is grok-4.7.
# WORDCRAFT_GROK_MODEL=grok-4.7
